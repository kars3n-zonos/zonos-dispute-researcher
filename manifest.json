{
  "manifest_version": 3,
  "name": "Zonos Dispute Researcher",
  "version": "0.15.0",
  "description": "Adds a Notes and Research panel to Zonos duty dispute pages: shared notes, saved Claude answers, and merchant research via Claude.",
  "homepage_url": "https://github.com/kars3n-zonos/zonos-dispute-researcher",
  "icons": {
    "16": "extension/icons/icon16.png",
    "32": "extension/icons/icon32.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "action": {
    "default_title": "Open Notes and Research",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "32": "extension/icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://brokerage.dashboard.zonos.com/*", "https://claude.ai/*"],
      "js": ["extension/gm-shim.js", "zonos-dispute-researcher.user.js"],
      "run_at": "document_start"
    }
  ]
}
